{"kind":"shape","id":"sh/lkn6x0za","slide":8,"bbox":[64,70,1152,2]}
{"kind":"textbox","id":"sh/adc7il0n","slide":8,"text":"Next: turn early evidence\ninto a tested MVP.","textPreview":"Next: turn early evidence | into a tested MVP.","textChars":44,"textLines":2,"bbox":[64,100,1100,80]}
{"kind":"shape","id":"sh/belor6h8","slide":8,"bbox":[64,330,220,150]}
